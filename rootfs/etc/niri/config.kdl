// System-wide niri config. niri would read ~/.config/niri/config.kdl first;
// NIRI_CONFIG (/usr/lib/environment.d/60-lighthouse.conf) pins it to this file.

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

environment {
    NOCTALIA_CONFIG_HOME "/etc/lighthouse"
    // Read-only: settings changed in Noctalia can't be saved, so they don't apply.
    NOCTALIA_STATE_HOME "/usr/share/lighthouse/noctalia-readonly"
    NOCTALIA_DATA_HOME "/usr/share/lighthouse/noctalia-readonly"
    XDG_SESSION_TYPE "wayland"
    // Web apps a parent added or changed (lighthouse-parent) come first.
    XDG_DATA_DIRS "/var/lib/lighthouse/apps:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
}

spawn-at-startup "noctalia"

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }
}

layout {
    gaps 16
    center-focused-column "never"

    // Each app fills the screen; Mod+R toggles half width for side by side.
    default-column-width { proportion 1.0; }
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }

    // Colours come from the current theme (included at the end).
    focus-ring {
        width 4
    }
}

window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}

// Fixed-size apps (like Tux Paint) would otherwise auto-float above the strip.
window-rule {
    match app-id="^TuxPaint"
    open-floating false
}

// The top-left hot corner would open the overview, where windows can be
// dragged between workspaces.
gestures {
    hot-corners {
        off
    }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

binds {
    // Help: shows the bindings that have a hotkey-overlay-title
    Mod+Slash       hotkey-overlay-title="Show these shortcuts" { show-hotkey-overlay; }
    Mod+Shift+Slash hotkey-overlay-title=null { show-hotkey-overlay; }

    // Launcher
    Mod+Space hotkey-overlay-title="Open an app" { spawn-sh "noctalia msg panel-toggle launcher"; }

    // Scroll the strip of windows
    Mod+Left  hotkey-overlay-title="Go to the app on the left"  { focus-column-left; }
    Mod+Right hotkey-overlay-title="Go to the app on the right" { focus-column-right; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+R     hotkey-overlay-title="Make this app half or full width" { switch-preset-column-width; }
    Mod+Q     hotkey-overlay-title="Close this app" { close-window; }

    // Volume & brightness keys
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
}

// Hardware-specific debug flags, written at boot by lighthouse-hardware.service.
include "/run/lighthouse/niri-hardware.kdl"

// The current theme's colours, written by lighthouse-theme.
include "/etc/lighthouse/theme/niri.kdl"
