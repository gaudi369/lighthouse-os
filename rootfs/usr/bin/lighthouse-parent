@media (prefers-color-scheme: dark) {{
  :root {{ --bg:#101B2D; --card:#1C2B44; --ink:#EAF0FA; --muted:#B7C4D8; --line:#2E4263;
          --primary:#F2C14E; --on-primary:#101B2D; --deny:#FF8A80; }} }}
