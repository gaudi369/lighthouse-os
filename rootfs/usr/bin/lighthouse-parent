input[type=time] {{ flex:0 1 9em; }}
</style></head><body><main>{body}</main></body></html>"""


def esc(s):
    return html.escape(str(s), quote=True)


class Handler(BaseHTTPRequestHandler):
    store = None
    token = None
    sessions = set()
    server_version = "lighthouse-parent"

    # plumbing

    def log_message(self, fmt, *args):
        sys.stderr.write("lighthouse-parent: %s\n" % (fmt % args))

    def send(self, status, body, content_type="text/html; charset=utf-8", headers=()):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, status, obj):
        self.send(status, json.dumps(obj), "application/json")

    def redirect(self, location, headers=()):
        self.send_response(HTTPStatus.SEE_OTHER)
        self.send_header("Location", location)
        self.send_header("Content-Length", "0")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()

    def body(self, limit=16384):
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(min(length, limit))

    def form(self):
        return {k: v[0] for k, v in parse_qs(self.body().decode(errors="replace")).items()}

    def is_local(self):
        return self.client_address[0] in LOCAL_CLIENTS

    def signed_in(self):
        cookie = SimpleCookie(self.headers.get("Cookie", ""))
        session = cookie.get("lighthouse_session")
        return session is not None and session.value in self.sessions

    # routes

    def do_GET(self):
        path = urlsplit(self.path).path
        if path.startswith("/api/requests/"):
            if not self.is_local():
                return self.send_json(HTTPStatus.FORBIDDEN, {"error": "kid API is local only"})
            r = self.store.request(path.rsplit("/", 1)[1])
            return self.send_json(HTTPStatus.OK if r else HTTPStatus.NOT_FOUND,
                                  {"status": r["status"]} if r else {"error": "no such request"})
        if path == "/":
            return self.send(HTTPStatus.OK, self.dashboard() if self.signed_in() else self.login_page())
        self.send(HTTPStatus.NOT_FOUND, PAGE.format(body="<p>Not found.</p>"))

    def do_POST(self):
        path = urlsplit(self.path).path
        if path == "/api/requests":
            return self.kid_request()
        if path == "/api/session":
            return self.kid_session()
        if path == "/login":
            return self.login()
        if not self.signed_in():
            return self.redirect("/")
        form = self.form()
        try:
            flash = self.parent_action(path, form)
        except (KeyError, ValueError) as e:
            flash = f"That didn't work: {e.args[0] if e.args else e}"
        self.send(HTTPStatus.OK, self.dashboard(flash))

    def kid_json(self):
        """The kid API's JSON body, or None after sending an error."""
        if not self.is_local():
            self.send_json(HTTPStatus.FORBIDDEN, {"error": "kid API is local only"})
            return None
        # JSON only: a web page can't send this cross-origin without a CORS preflight.
        if self.headers.get("Content-Type", "").split(";")[0].strip() != "application/json":
            self.send_json(HTTPStatus.UNSUPPORTED_MEDIA_TYPE, {"error": "JSON only"})
            return None
        try:
            data = json.loads(self.body())
        except ValueError:
            data = None
        if not isinstance(data, dict):
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": "bad request"})
            return None
        return data

    def kid_request(self):
        if (data := self.kid_json()) is None:
            return
        try:
            if data.get("kind") == "time":
                r = self.store.add_time_request()
            else:
                r = self.store.add_request(str(data["app"]), str(data["url"]))
        except (ValueError, KeyError, TypeError):
            return self.send_json(HTTPStatus.BAD_REQUEST, {"error": "bad request"})
        self.send_json(HTTPStatus.CREATED, {"id": r["id"], "status": r["status"]})

    def kid_session(self):
        if (data := self.kid_json()) is None:
            return
        self.send_json(HTTPStatus.OK, self.store.heartbeat(bool(data.get("active"))))

    def login(self):
        token = self.form().get("token", "").strip()
        if not hmac.compare_digest(token.encode(), self.token.encode()):
            time.sleep(1)
            return self.send(HTTPStatus.UNAUTHORIZED, self.login_page("That code isn't right."))
        session = secrets.token_urlsafe(24)
        self.sessions.add(session)
        self.redirect("/", [("Set-Cookie", f"lighthouse_session={session}; HttpOnly; SameSite=Strict; Path=/")])

    def parent_action(self, path, form):
        parts = path.strip("/").split("/")
        if parts[:1] == ["requests"] and len(parts) == 3:
            r = self.store.request(parts[1])
            if r is None:
                raise KeyError("no such request")
            if parts[2] == "approve":
                self.store.decide(parts[1], True, form.get("domain") or None)
                if r.get("kind") == "time":
                    return f"Gave {r['minutes']} more minutes."
                return f"Allowed {form.get('domain') or suggested_domain(r['host'])}."
            if parts[2] == "deny":
                self.store.decide(parts[1], False)
                return "Said no."
        if parts[:1] == ["apps"] and len(parts) == 3:
            app_id, action = parts[1], parts[2]
            if action == "allow":
                self.store.allow_domain(app_id, form.get("domain", ""))
                return f"Added {form.get('domain')}."
            if action == "remove-domain":
                self.store.remove_domain(app_id, form.get("domain", ""))
                return f"Removed {form.get('domain')}."
            if action == "remove":
                self.store.remove_app(app_id)
                return "Removed the app."
        if parts == ["apps"]:
            app_id = self.store.add_app(form.get("name", ""), form.get("url", ""))
            return f"Added {self.store.app(app_id)['name']}. It's in the launcher now."
        if parts == ["time", "limits"]:
            def minutes(key):
                value = form.get(key, "").strip()
                if not value:
                    return None
                if not value.isdigit():
                    raise ValueError("minutes must be a number")
                return int(value)
            self.store.set_limits(minutes("weekday_minutes"), minutes("weekend_minutes"),
                                  form.get("opens", "").strip() or None,
                                  form.get("closes", "").strip() or None)
            return "Saved screen time."
        if parts == ["time", "give"]:
            minutes = int(form.get("minutes", "0")) if form.get("minutes", "").isdigit() else 0
            self.store.give_time(minutes)
            return f"Gave {minutes} more minutes."
        if parts == ["time", "lock"]:
            self.store.set_paused(True)
            return "Locked the computer. It stays locked until you unlock it."
        if parts == ["time", "unlock"]:
            self.store.set_paused(False)
            return "Unlocked the computer."
        raise KeyError("unknown action")

    # pages

    def login_page(self, error=""):
        return PAGE.format(body=f"""
<h1>Lighthouse for grown-ups</h1>
{f'<p class="flash">{esc(error)}</p>' if error else ''}
<form class="card" method="post" action="/login">
  <p>Enter the parent code. On the computer, run <code>sudo lighthouse-parent token</code>.</p>
  <div class="row"><input name="token" autocomplete="current-password" placeholder="Parent code" required>
  <button>Sign in</button></div>
</form>""")

    def dashboard(self, flash=""):
        apps = {a["id"]: a for a in self.store.apps()}
        pending = self.store.requests("pending")
        out = ["<h1>Lighthouse for grown-ups</h1>"]
        if flash:
            out.append(f'<p class="flash">{esc(flash)}</p>')

        out.append(f"<h2>Asking to visit ({len(pending)})</h2>")
        if not pending:
            out.append('<p class="muted">Nothing waiting.</p>')
        for r in sorted(pending, key=lambda r: r["created"]):
            asked = time.strftime("%b %d, %H:%M", time.localtime(r["created"]))
            if r.get("kind") == "time":
                out.append(f"""<div class="card">
  Asking for <strong>{r['minutes']} more minutes</strong> of screen time
  <div class="muted">asked {esc(asked)}</div>
  <div class="row">
    <form method="post" action="/requests/{esc(r['id'])}/approve"><button>Give {r['minutes']} minutes</button></form>
    <form method="post" action="/requests/{esc(r['id'])}/deny"><button class="quiet">Not now</button></form>
  </div></div>""")
                continue
            app_name = apps.get(r["app"], {}).get("name", r["app"])
            domain = suggested_domain(r["host"])
            out.append(f"""<div class="card">
  <strong>{esc(app_name)}</strong> wants to open <strong>{esc(r['host'])}</strong>
  <div class="muted">{esc(r['url'])} · asked {esc(asked)}</div>
  <div class="row">
    <form method="post" action="/requests/{esc(r['id'])}/approve">
      <input type="hidden" name="domain" value="{esc(domain)}">
      <button>Allow {esc(domain)}</button></form>
    <form method="post" action="/requests/{esc(r['id'])}/deny"><button class="quiet">Not now</button></form>
  </div></div>""")

        out.append(self.screen_time_section())

        out.append("<h2>Web apps</h2>")
        for a in apps.values():
            chips = []
            for d in a["allow"]:
                if d in a["builtin_allow"] and not a["added_by_parent"]:
                    chips.append(f'<span class="chip fixed">{esc(d)}</span>')
                else:
                    chips.append(f"""<span class="chip">{esc(d)}
<form method="post" action="/apps/{esc(a['id'])}/remove-domain"><input type="hidden" name="domain" value="{esc(d)}"><button class="quiet" aria-label="Remove {esc(d)}">Remove</button></form></span>""")
            remove = (f'<form method="post" action="/apps/{esc(a["id"])}/remove"><button class="quiet">Remove app</button></form>'
                      if a["added_by_parent"] else "")
            out.append(f"""<div class="card">
  <strong>{esc(a['name'])}</strong> <span class="muted">{esc(a['url'])}</span>
  <div>{''.join(chips)}</div>
  <form class="row" method="post" action="/apps/{esc(a['id'])}/allow">
    <input name="domain" placeholder="Allow another site, e.g. example.org" required>
    <button>Allow</button></form>
  <div class="row">{remove}</div>
</div>""")

        out.append("""<h2>Add a web app</h2>
<form class="card" method="post" action="/apps">
  <div class="row"><input name="name" placeholder="Name, e.g. NASA Kids" required></div>
  <div class="row"><input name="url" placeholder="https://..." required><button>Add</button></div>
  <p class="muted">The app can visit the site you enter. Anything else it links to will show up above as a question.</p>
</form>""")
        return PAGE.format(body="\n".join(out))

    def screen_time_section(self):
        limits, now = self.store.limits(), self.store.screen_time()

        def mins(seconds):
            return f"{round(seconds / 60)} min"

        if now["state"] == "locked":
            state = {"paused": "Locked by a grown-up", "closed": f"Closed until {now['opens']}",
                     "used-up": "Today's time is used up"}[now["reason"]]
        elif now["remaining"] is not None:
            state = f"Open, {mins(now['remaining'])} left"
        else:
            state = "Open"
        used = mins(now["used"]) + (f" of {mins(now['limit'])}" if now["limit"] is not None else "")
        lock = ('<form method="post" action="/time/unlock"><button>Unlock</button></form>'
                if limits["paused"] else
                '<form method="post" action="/time/lock"><button class="quiet">Lock now</button></form>')
        give = "".join(f"""<form method="post" action="/time/give"><input type="hidden" name="minutes" value="{m}">
<button>Give {m} more minutes</button></form>""" for m in (15, 30))

        def value(key):
            return "" if limits[key] is None else esc(limits[key])

        return f"""<h2>Screen time</h2>
<div class="card">
  <strong>{esc(state)}</strong> <span class="muted">Used today: {esc(used)}</span>
  <div class="row">{give}{lock}</div>
</div>
<form class="card" method="post" action="/time/limits">
  <div class="row"><label for="wd">School days (Mon–Fri), minutes</label>
    <input id="wd" name="weekday_minutes" inputmode="numeric" placeholder="No limit" value="{value('weekday_minutes')}"></div>
  <div class="row"><label for="we">Weekends, minutes</label>
    <input id="we" name="weekend_minutes" inputmode="numeric" placeholder="No limit" value="{value('weekend_minutes')}"></div>
  <div class="row"><label for="op">Open from</label>
    <input id="op" name="opens" type="time" value="{value('opens')}">
    <label for="cl">until</label>
    <input id="cl" name="closes" type="time" value="{value('closes')}"></div>
  <div class="row"><button>Save</button></div>
  <p class="muted">Leave a box empty for no limit. Screen time counts while the computer is unlocked.
  When time is up, the screen locks with a button to ask you for {EXTRA_MINUTES} more minutes.</p>
</form>"""


class DualStackServer(ThreadingHTTPServer):
    """Listens on IPv6 and IPv4 (IPv4 clients appear as ::ffff:a.b.c.d)."""
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


def serve():
    STATE.mkdir(parents=True, exist_ok=True)
    Handler.store = Store()
    Handler.token = ensure_token()
    server = DualStackServer(("::", PORT), Handler)
    print(f"lighthouse-parent: listening on port {PORT}", file=sys.stderr, flush=True)
    if os.environ.get("LIGHTHOUSE_PARENT_SHOW_TOKEN"):  # mise run parent
        print(f"Open http://localhost:{PORT} and sign in with: {Handler.token}", flush=True)
    server.serve_forever()


def main():
    command = sys.argv[1:2]
    if command == ["serve"]:
        serve()
    elif command == ["token"]:
        try:
            print(token_path().read_text().strip())
        except PermissionError:
            sys.exit("lighthouse-parent: permission denied (run with sudo)")
        except FileNotFoundError:
            sys.exit("lighthouse-parent: no token yet (is lighthouse-parent.service running?)")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
