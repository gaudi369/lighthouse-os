#!/usr/bin/python3
"""Lighthouse parent service: the kid asks, a grown-up approves.

    lighthouse-parent serve       run the service (lighthouse-parent.service)
    lighthouse-parent passphrase  set a new parent passphrase (needs sudo; for
                                  a forgotten one)

On first boot the kid's screen shows a setup screen (lighthouse-timekeeper)
where a grown-up connects to Wi-Fi and chooses the parent passphrase. Until
then the parent page can't be signed in to. Parents then open
http://lighthouse.local:8080 (or the computer's address) and sign in to:
  - allow or deny sites the kid asked for (from a web app's "Ask a grown-up")
  - see and change each web app's allowed sites
  - add new web apps
  - set screen time (a daily limit and the hours the computer is open),
    give more time, or lock the computer now

Kid-side API, accepted only from this computer and only as JSON:
  POST /api/requests        {"app": "pbskids", "url": "https://..."} -> {"id": ...}
                            {"kind": "time"} asks for more time -> {"id": ...}
  GET  /api/requests/<id>   -> {"status": "pending" | "approved" | "denied"}
  POST /api/session         {"active": true} every 30 s from lighthouse-timekeeper;
                            counts screen time and returns whether to lock
                            -> {"state": "open" | "locked" | "setup", "reason", "remaining", "opens"}
  POST /api/setup           {"passphrase": "..."} from the first-boot setup screen;
                            only works while no passphrase is set

Approved changes are written as desktop entries in
$STATE/apps/applications/, which lighthouse-webapp and the launcher read
before the built-in ones in /usr/share/applications.
"""

import configparser
import datetime
import getpass
import hashlib
import hmac
import html
import io
import json
import os
import re
import secrets
import socket
import sys
import threading
import time
import uuid
from http import HTTPStatus
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

STATE = Path(os.environ.get("LIGHTHOUSE_STATE_DIR", "/var/lib/lighthouse"))
SYSTEM_APPS = Path(os.environ.get("LIGHTHOUSE_SYSTEM_APPS", "/usr/share/applications"))
PORT = int(os.environ.get("LIGHTHOUSE_PARENT_PORT", "8080"))
LOCAL_CLIENTS = {"127.0.0.1", "::1", "::ffff:127.0.0.1"}
APP_ID = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
DOMAIN = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
CLOCK = re.compile(r"^([01][0-9]|2[0-3]):[0-5][0-9]$")
EXTRA_MINUTES = 15          # what "Ask for more time" asks for
HEARTBEAT_GAP = 120         # seconds; a longer gap (sleep, crash) isn't counted as screen time
USAGE_DAYS = 31             # days of screen time history kept
PASSPHRASE_MIN = 8          # characters
LOGIN_TRIES = 5             # wrong passphrases in a row before a pause
LOGIN_PAUSE = 60            # seconds
NO_LIMITS = {"weekday_minutes": None, "weekend_minutes": None, "opens": None, "closes": None,
             "paused": False, "extra_until": 0}


# --- storage -----------------------------------------------------------------

class Store:
    """Requests (requests.json) and the parent's copies of app desktop entries."""

    def __init__(self, state=STATE, system_apps=SYSTEM_APPS):
        self.state = Path(state)
        self.system_apps = Path(system_apps)
        self.parent_apps = self.state / "apps" / "applications"
        self.requests_file = self.state / "requests.json"
        self.limits_file = self.state / "limits.json"
        self.usage_file = self.state / "usage.json"
        self.passphrase_file = passphrase_path(self.state)
        self.lock = threading.Lock()
        self.last_beat = None  # when lighthouse-timekeeper last reported an unlocked screen
        self.parent_apps.mkdir(parents=True, exist_ok=True)

    # Parent passphrase

    def passphrase(self):
        """The stored passphrase ({"salt", "scrypt"}), or None before setup."""
        return self._read_json(self.passphrase_file, None)

    def set_passphrase(self, passphrase, first=False):
        """Save a new passphrase. With first=True, only if none is set (FileExistsError)."""
        with self.lock:
            if first and self.passphrase_file.exists():
                raise FileExistsError("a passphrase is already set")
            return save_passphrase(self.state, passphrase)

    def check_passphrase(self, passphrase):
        """The stored passphrase if `passphrase` matches it, else None."""
        stored = self.passphrase()
        if stored is None:
            return None
        attempt = hash_passphrase(passphrase, bytes.fromhex(stored["salt"]))
        return stored if hmac.compare_digest(attempt["scrypt"], stored["scrypt"]) else None

    # Requests

    @staticmethod
    def _read_json(path, default):
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            return default

    @staticmethod
    def _write_json(path, data):
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2))
        tmp.replace(path)

    def _load(self):
        return self._read_json(self.requests_file, [])

    def _save(self, requests):
        self._write_json(self.requests_file, requests)

    def requests(self, status=None):
        with self.lock:
            return [r for r in self._load() if status is None or r["status"] == status]

    def add_request(self, app_id, url):
        host = (urlsplit(url).hostname or "").lower()
        if not self.app(app_id) or urlsplit(url).scheme not in ("http", "https") or not DOMAIN.match(host):
            raise ValueError("unknown app or unusable URL")
        with self.lock:
            requests = self._load()
            for r in requests:  # asking twice doesn't queue twice
                if r["status"] == "pending" and r.get("app") == app_id and r.get("host") == host:
                    return r
            r = {"id": uuid.uuid4().hex, "kind": "site", "app": app_id, "url": url, "host": host,
                 "status": "pending", "created": int(time.time())}
            requests.append(r)
            self._save(requests)
            return r

    def add_time_request(self):
        with self.lock:
            requests = self._load()
            for r in requests:
                if r["status"] == "pending" and r.get("kind") == "time":
                    return r
            r = {"id": uuid.uuid4().hex, "kind": "time", "minutes": EXTRA_MINUTES,
                 "status": "pending", "created": int(time.time())}
            requests.append(r)
            self._save(requests)
            return r

    def request(self, request_id):
        return next((r for r in self.requests() if r["id"] == request_id), None)

    def decide(self, request_id, approve, domain=None):
        with self.lock:
            requests = self._load()
            r = next((r for r in requests if r["id"] == request_id and r["status"] == "pending"), None)
            if r is None:
                raise KeyError(request_id)
            if approve and r.get("kind") == "time":
                self._give_time(r["minutes"])
            elif approve:
                self.allow_domain(r["app"], domain or suggested_domain(r["host"]))
            r["status"] = "approved" if approve else "denied"
            r["decided"] = int(time.time())
            # Answering one request answers the other pending asks it covers.
            if approve and r.get("kind") != "time":
                entry = self.app(r["app"])
                for other in requests:
                    if (other["status"] == "pending" and other.get("app") == r["app"]
                            and host_allowed(other["host"], entry["allow"])):
                        other["status"], other["decided"] = "approved", r["decided"]
            self._save(requests)
            return r

    # Screen time

    def limits(self):
        return {**NO_LIMITS, **self._read_json(self.limits_file, {})}

    def set_limits(self, weekday_minutes, weekend_minutes, opens, closes):
        """Minutes are ints or None (no limit); opens/closes are "HH:MM" or None (always open)."""
        for minutes in (weekday_minutes, weekend_minutes):
            if minutes is not None and not 0 <= minutes <= 24 * 60:
                raise ValueError("minutes must be between 0 and 1440")
        if (opens is None) != (closes is None):
            raise ValueError("set both times, or neither")
        if opens is not None:
            if not (CLOCK.match(opens) and CLOCK.match(closes)):
                raise ValueError("times look like 07:30")
            if opens >= closes:
                raise ValueError("the computer must open before it closes")
        with self.lock:
            limits = self.limits()
            limits.update(weekday_minutes=weekday_minutes, weekend_minutes=weekend_minutes,
                          opens=opens, closes=closes)
            self._write_json(self.limits_file, limits)

    def _give_time(self, minutes, now=None):
        """Open the computer for `minutes` more, whatever the limits say. Caller holds the lock."""
        now = time.time() if now is None else now
        limits = self.limits()
        limits["extra_until"] = int(max(now, limits["extra_until"]) + minutes * 60)
        limits["paused"] = False
        self._write_json(self.limits_file, limits)

    def give_time(self, minutes, now=None):
        if not 1 <= minutes <= 240:
            raise ValueError("between 1 and 240 minutes")
        with self.lock:
            self._give_time(minutes, now)

    def set_paused(self, paused):
        with self.lock:
            limits = self.limits()
            limits["paused"] = bool(paused)
            if paused:
                limits["extra_until"] = 0
            self._write_json(self.limits_file, limits)

    def usage(self, day):
        """Seconds of screen time on `day` (a datetime.date)."""
        return self._read_json(self.usage_file, {}).get(day.isoformat(), 0)

    def heartbeat(self, active, now=None):
        """lighthouse-timekeeper reports in; count the time since the last report while unlocked."""
        now = time.time() if now is None else now
        with self.lock:
            if active and self.last_beat is not None and 0 < now - self.last_beat <= HEARTBEAT_GAP:
                day = datetime.date.fromtimestamp(now).isoformat()
                usage = self._read_json(self.usage_file, {})
                usage[day] = round(usage.get(day, 0) + now - self.last_beat)
                for old in sorted(usage)[:-USAGE_DAYS]:
                    del usage[old]
                self._write_json(self.usage_file, usage)
            self.last_beat = now if active else None
        return self.screen_time(now)

    def screen_time(self, now=None):
        """Whether the computer is open now, and why not.

        state: "open" or "locked"; reason: "paused" | "closed" | "used-up" (locked) or None;
        remaining: seconds until it locks (None if nothing will lock it);
        opens: "HH:MM" when it opens again (None if a grown-up has to unlock it, or the
        day's time is used up); used / limit: today's seconds.
        """
        now = time.time() if now is None else now
        limits = self.limits()
        moment = datetime.datetime.fromtimestamp(now)
        weekend = moment.weekday() >= 5
        minutes = limits["weekend_minutes" if weekend else "weekday_minutes"]
        limit = None if minutes is None else minutes * 60
        used = self.usage(moment.date())
        clock = moment.strftime("%H:%M")
        status = {"used": used, "limit": limit, "opens": None, "remaining": None}

        if limits["paused"]:
            return {**status, "state": "locked", "reason": "paused"}
        if now < limits["extra_until"]:
            return {**status, "state": "open", "reason": None, "remaining": int(limits["extra_until"] - now)}
        if limits["opens"] and not limits["opens"] <= clock < limits["closes"]:
            return {**status, "state": "locked", "reason": "closed", "opens": limits["opens"]}
        if limit is not None and used >= limit:
            return {**status, "state": "locked", "reason": "used-up"}

        remaining = []
        if limit is not None:
            remaining.append(limit - used)
        if limits["closes"]:
            h, m = map(int, limits["closes"].split(":"))
            closes = moment.replace(hour=h, minute=m, second=0, microsecond=0)
            remaining.append((closes - moment).total_seconds())
        return {**status, "state": "open", "reason": None,
                "remaining": int(min(remaining)) if remaining else None}

    # Apps

    def _read_entry(self, path):
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        parser.optionxform = str
        parser.read(path)
        return parser

    def app_path(self, app_id):
        for d in (self.parent_apps, self.system_apps):
            path = d / f"{app_id}.desktop"
            if path.is_file():
                return path
        return None

    def app(self, app_id):
        if not APP_ID.match(app_id or ""):
            return None
        path = self.app_path(app_id)
        if path is None:
            return None
        entry = self._read_entry(path)["Desktop Entry"]
        if "X-Lighthouse-Url" not in entry:
            return None
        builtin = self.system_apps / f"{app_id}.desktop"
        builtin_allow = (self._read_entry(builtin)["Desktop Entry"].get("X-Lighthouse-Allow", "")
                         if builtin.is_file() else "")
        return {
            "id": app_id,
            "name": entry.get("Name", app_id),
            "url": entry["X-Lighthouse-Url"],
            "allow": [d for d in entry.get("X-Lighthouse-Allow", "").split(";") if d],
            "builtin_allow": [d for d in builtin_allow.split(";") if d],
            "added_by_parent": not builtin.is_file(),
        }

    def apps(self):
        ids = {p.stem for d in (self.parent_apps, self.system_apps) for p in d.glob("*.desktop")}
        return [a for a in (self.app(i) for i in sorted(ids)) if a]

    def _write_app(self, app_id, parser):
        buf = io.StringIO()
        parser.write(buf, space_around_delimiters=False)
        path = self.parent_apps / f"{app_id}.desktop"
        tmp = path.with_suffix(".tmp")
        tmp.write_text("# Written by lighthouse-parent\n" + buf.getvalue())
        tmp.chmod(0o644)
        tmp.replace(path)

    def set_allow(self, app_id, domains):
        path = self.app_path(app_id)
        if path is None:
            raise KeyError(app_id)
        parser = self._read_entry(path)
        parser["Desktop Entry"]["X-Lighthouse-Allow"] = "".join(f"{d};" for d in domains)
        self._write_app(app_id, parser)

    def allow_domain(self, app_id, domain):
        domain = domain.lower().strip()
        if not DOMAIN.match(domain):
            raise ValueError(f"not a domain: {domain}")
        app = self.app(app_id)
        if app is None:
            raise KeyError(app_id)
        if domain not in app["allow"]:
            self.set_allow(app_id, app["allow"] + [domain])

    def remove_domain(self, app_id, domain):
        app = self.app(app_id)
        if app is None:
            raise KeyError(app_id)
        if domain in app["builtin_allow"] and not app["added_by_parent"]:
            raise ValueError("built-in domains can't be removed")
        self.set_allow(app_id, [d for d in app["allow"] if d != domain])

    def add_app(self, name, url):
        parts = urlsplit(url.strip())
        host = (parts.hostname or "").lower()
        if parts.scheme != "https" or not DOMAIN.match(host):
            raise ValueError("the address must start with https://")
        slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or "app"
        app_id = f"parent-{slug}"
        if self.app_path(app_id):
            raise ValueError("there is already an app with that name")
        parser = configparser.ConfigParser(interpolation=None)
        parser.optionxform = str
        parser["Desktop Entry"] = {
            "Type": "Application",
            "Name": name.strip()[:60],
            "Exec": f"lighthouse-webapp {app_id}",
            "Icon": "applications-internet",
            "Terminal": "false",
            "Categories": "Education;",
            "StartupWMClass": f"org.lighthouse.webapp.{app_id.replace('-', '_')}",
            "X-Lighthouse-Url": url.strip(),
            "X-Lighthouse-Allow": f"{suggested_domain(host)};",
        }
        self._write_app(app_id, parser)
        return app_id

    def remove_app(self, app_id):
        app = self.app(app_id)
        if app is None or not app["added_by_parent"]:
            raise ValueError("only apps a parent added can be removed")
        (self.parent_apps / f"{app_id}.desktop").unlink()


def suggested_domain(host):
    return host[4:] if host.startswith("www.") else host


def host_allowed(host, allow):
    return any(host == d or host.endswith("." + d) for d in allow)


# --- passphrase ------------------------------------------------------------------

def passphrase_path(state):
    return Path(state) / "parent-passphrase"


def hash_passphrase(passphrase, salt=None):
    # Phones add a trailing space after a suggested word; it's never meant.
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.scrypt(passphrase.strip().encode(), salt=salt, n=2**14, r=8, p=1)
    return {"salt": salt.hex(), "scrypt": digest.hex()}


def save_passphrase(state, passphrase):
    """Hash and store a new passphrase, readable only by the service. Returns the stored record."""
    if len(passphrase.strip()) < PASSPHRASE_MIN:
        raise ValueError(f"use at least {PASSPHRASE_MIN} characters")
    record = hash_passphrase(passphrase)
    path = passphrase_path(state)
    tmp = path.with_suffix(".tmp")
    tmp.unlink(missing_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(record, f)
    if os.geteuid() == 0:  # `sudo lighthouse-parent passphrase`: the service must still read it
        owner = os.stat(state)
        os.chown(tmp, owner.st_uid, owner.st_gid)
    tmp.replace(path)
    return record


# --- web -----------------------------------------------------------------------

