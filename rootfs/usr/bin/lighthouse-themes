#!/usr/bin/python3
"""Choose Your Friend: the kid's theme picker.

Shows every Lighthouse theme as a big picture button. Picking one runs
`pkexec lighthouse-theme set <id>` (allowed without a password for the active
session; see org.lighthouse.theme.policy), then asks niri and Noctalia to
reload. If a parent has run `lighthouse-theme lock`, the buttons are disabled
and a friendly note says so.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk  # noqa: E402

THEMES = Path("/usr/share/lighthouse/themes")
CURRENT = Path("/etc/lighthouse/theme/theme.json")
LOCK = Path("/etc/lighthouse/theme.lock")

CSS = """
window {{ background: {surface}; color: {on_surface}; }}
.title {{ font-size: 32px; font-weight: 800; }}
.note {{ font-size: 18px; color: {on_surface_variant}; }}
.card {{ background: {surface_variant}; color: {on_surface_variant}; border-radius: 22px;
        padding: 10px; border: 4px solid transparent; }}
.card:hover {{ border-color: {outline}; }}
.card:focus-visible {{ outline: 4px solid {primary}; outline-offset: 2px; }}
.card.chosen {{ border-color: {primary}; }}
.card picture {{ border-radius: 14px; }}
.name {{ font-size: 20px; font-weight: 700; }}
.chip {{ font-size: 14px; font-weight: 700; border-radius: 999px; padding: 2px 10px;
        background: {primary}; color: {on_primary}; }}
"""


def load_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def all_themes():
    return [t for p in sorted(THEMES.iterdir()) if (t := load_json(p / "theme.json"))]


def run_quietly(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


class Picker:
    def __init__(self, app):
        self.css = Gtk.CssProvider()
        self.window = Gtk.ApplicationWindow(application=app, title="Choose a Theme")
        self.window.set_default_size(1200, 820)
        Gtk.StyleContext.add_provider_for_display(
            self.window.get_display(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                      margin_top=28, margin_bottom=28, margin_start=28, margin_end=28)
        box.append(Gtk.Label(label="Choose your friend!", css_classes=["title"]))
        self.note = Gtk.Label(css_classes=["note"], wrap=True)
        box.append(self.note)

        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=4, min_children_per_line=4,
                           row_spacing=18, column_spacing=18, valign=Gtk.Align.START)
        self.cards = {}
        for theme in all_themes():
            card = self.make_card(theme)
            self.cards[theme["id"]] = card
            grid.append(card)
        box.append(Gtk.ScrolledWindow(child=grid, vexpand=True,
                                      hscrollbar_policy=Gtk.PolicyType.NEVER))
        self.window.set_child(box)
        self.refresh()
        self.window.present()

    def make_card(self, theme):
        picture = Gtk.Picture.new_for_filename(str(THEMES / theme["id"] / "wallpaper.svg"))
        picture.set_content_fit(Gtk.ContentFit.COVER)
        picture.set_size_request(200, 120)

        mode = "Night" if theme["mode"] == "dark" else "Day"
        label_row = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        label_row.append(Gtk.Label(label=theme["name"], css_classes=["name"]))
        label_row.append(Gtk.Label(label=mode, css_classes=["chip"]))

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.append(picture)
        content.append(label_row)

        button = Gtk.Button(child=content, css_classes=["card"], tooltip_text=theme["description"])
        button.update_property([Gtk.AccessibleProperty.LABEL],
                               [f"{theme['name']} theme, {mode.lower()}"])
        button.connect("clicked", lambda _b: self.choose(theme["id"]))
        return button

    def refresh(self):
        current = load_json(CURRENT) or {}
        if "colors" in current:
            self.css.load_from_string(CSS.format(**current["colors"]))
        locked = LOCK.exists()
        for theme_id, card in self.cards.items():
            card.set_sensitive(not locked)
            if theme_id == current.get("id"):
                card.add_css_class("chosen")
            else:
                card.remove_css_class("chosen")
        self.note.set_label("A grown-up has picked the theme for now." if locked
                            else "Tap a picture to change your colours and background.")

    def choose(self, theme_id):
        cmd = ["lighthouse-theme", "set", theme_id]
        if os.geteuid() != 0:
            cmd.insert(0, "pkexec")
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(result.stderr.strip(), file=sys.stderr)
            self.note.set_label("That didn't work. Ask a grown-up for help.")
            return
        # niri and Noctalia usually notice the new files themselves; ask anyway.
        run_quietly("niri", "msg", "action", "load-config-file")
        run_quietly("noctalia", "msg", "config-reload")
        self.refresh()


def main():
    app = Gtk.Application(application_id="org.lighthouse.Themes")
    app.connect("activate", lambda a: (a.get_active_window() or Picker(a).window).present())
    return app.run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
