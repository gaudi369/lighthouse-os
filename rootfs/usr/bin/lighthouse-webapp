#!/usr/bin/python3
"""Run a web site as a locked-down app.

Each app is a desktop entry, <id>.desktop, in /var/lib/lighthouse/apps/applications
(the parent's copies, written by lighthouse-parent) or /usr/share/applications:

    Exec=lighthouse-webapp <id>
    X-Lighthouse-Url=https://pbskids.org/
    X-Lighthouse-Allow=pbskids.org;pbs.org;
    X-Lighthouse-Engine=blink             (optional: blink | chromium)
    X-Lighthouse-UserAgent=...            (optional: for sites that sniff the browser)

The blink engine (Chromium's renderer, via QtWebEngine) makes every navigation
(pages, frames, redirects, pop-ups) stay inside the app's allowlist; anything
else is blocked and logged to stderr. A blocked page shows "Ask a grown-up",
which sends a request to lighthouse-parent and opens the page once it's allowed.
Each app gets its own storage and its own Wayland app id. The chromium engine runs Chromium itself, where only the global
managed policy applies.
"""

import argparse
import configparser
import html
import json
import os
import re
import sys
import urllib.request
from pathlib import Path
from urllib.parse import parse_qs, quote, urlsplit

DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
THEME = "/etc/lighthouse/theme/theme.json"
ICONS = Path("/usr/share/icons/Adwaita/symbolic/actions")
PARENT_URL = os.environ.get("LIGHTHOUSE_PARENT_URL", "http://127.0.0.1:8080")
# Only system-owned directories: an entry in the kid's home must not widen an allowlist.
APP_DIRS = [Path(d) for d in os.environ.get(
    "LIGHTHOUSE_APP_DIRS", "/var/lib/lighthouse/apps/applications:/usr/share/applications").split(":")]


def find_desktop_entry(app_id):
    for d in APP_DIRS:
        path = d / f"{app_id}.desktop"
        if path.is_file():
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str  # keys are case-sensitive
            parser.read(path)
            return path, parser["Desktop Entry"]
    return None, None


class App:
    def __init__(self, app_id):
        self.id = app_id
        self.path, entry = find_desktop_entry(app_id)
        if entry is None:
            sys.exit(f"lighthouse-webapp: no desktop entry for '{app_id}'")
        self.name = entry.get("Name", app_id)
        self.url = entry.get("X-Lighthouse-Url")
        self.engine = entry.get("X-Lighthouse-Engine", "blink")
        self.user_agent = entry.get("X-Lighthouse-UserAgent")
        self.load_allow(entry)
        if not self.url or not self.allow:
            sys.exit(f"lighthouse-webapp: '{app_id}' needs X-Lighthouse-Url and X-Lighthouse-Allow")

    def load_allow(self, entry):
        self.allow = [d for d in entry.get("X-Lighthouse-Allow", "").split(";") if d]
        self.stamp = self.entry_stamp()

    def entry_stamp(self):
        # The parent's copy may appear (or change) while the app runs.
        try:
            path, _ = find_desktop_entry(self.id)
            return path, path.stat().st_mtime_ns
        except (AttributeError, OSError):
            return None

    def refresh(self):
        if getattr(self, "stamp", None) is not None and self.entry_stamp() != self.stamp:
            _, entry = find_desktop_entry(self.id)
            if entry is not None:
                self.load_allow(entry)

    def allows(self, uri):
        self.refresh()
        parts = urlsplit(uri)
        if parts.scheme in ("about", "data", "blob"):
            return True
        if parts.scheme not in ("http", "https"):
            return False
        host = (parts.hostname or "").lower()
        return any(host == d or host.endswith("." + d) for d in self.allow)


def blocked(app, what):
    print(f"lighthouse-webapp[{app.id}]: blocked {what}", file=sys.stderr, flush=True)


def ask_parent(app, url):
    """Queue a request with lighthouse-parent; returns its id, or None if unreachable."""
    body = json.dumps({"app": app.id, "url": url}).encode()
    req = urllib.request.Request(f"{PARENT_URL}/api/requests", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=3) as r:
            return json.load(r)["id"]
    except (OSError, ValueError, KeyError):
        return None


def request_status(request_id):
    try:
        with urllib.request.urlopen(f"{PARENT_URL}/api/requests/{quote(request_id)}", timeout=2) as r:
            return json.load(r).get("status")
    except (OSError, ValueError):
        return None


KID_PAGE = """<!doctype html><html><head><meta charset="utf-8"><title>{title}</title><style>
body {{ margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
       background:{surface}; color:{on_surface}; font-family:"Noto Sans",sans-serif; text-align:center; }}
main {{ max-width:640px; padding:32px; }}
.big {{ font-size:72px; line-height:1; }}
h1 {{ font-size:34px; margin:18px 0 8px; }}
p {{ font-size:20px; color:{on_surface_variant}; }}
.site {{ display:inline-block; margin:6px 0 22px; padding:6px 16px; border-radius:999px;
        background:{surface_variant}; color:{on_surface_variant}; font-weight:700; overflow-wrap:anywhere; }}
button {{ font:inherit; font-size:22px; font-weight:800; border:0; border-radius:999px; padding:14px 28px;
         margin:8px; cursor:pointer; background:{primary}; color:{on_primary}; }}
button.quiet {{ background:{surface_variant}; color:{on_surface_variant}; }}
button:focus-visible {{ outline:4px solid {secondary}; outline-offset:3px; }}
</style></head><body><main>{body}</main></body></html>"""

DEFAULT_COLORS = {"surface": "#F7F9F4", "on_surface": "#1C2733", "surface_variant": "#E2EBF3",
                  "on_surface_variant": "#27384A", "primary": "#2A64A8", "on_primary": "#FFFFFF",
                  "secondary": "#2C7340"}


def kid_page(app, kind, url, theme):
    """The pages a kid sees when a site isn't allowed yet."""
    host = urlsplit(url).hostname or url
    site = f'<div class="site">{html.escape(host)}</div>'
    back = '<button class="quiet" onclick="history.back()">Go back</button>'
    if kind == "blocked":
        ask = f"lighthouse://ask?url={quote(url, safe='')}"
        title, body = "Ask a grown-up", f"""<div class="big">🔒</div>
<h1>This page isn't in {html.escape(app.name)} yet</h1>{site}
<p>A grown-up can say yes to it.</p>
<button autofocus onclick="location.replace('{ask}')">🙋 Ask a grown-up</button>{back}"""
    elif kind == "asked":
        title, body = "Asked a grown-up", f"""<div class="big">💌</div>
<h1>You asked a grown-up!</h1>{site}
<p>This page opens by itself as soon as they say yes.</p>{back}"""
    elif kind == "denied":
        title, body = "Not this time", f"""<div class="big">🙂</div>
<h1>A grown-up said not this time</h1>{site}{back}"""
    else:  # offline
        title, body = "Ask a grown-up", f"""<div class="big">🙋</div>
<h1>Couldn't send your question</h1>{site}
<p>Ask a grown-up in person to allow it.</p>{back}"""
    colors = {**DEFAULT_COLORS, **(theme["colors"] if theme else {})}
    return KID_PAGE.format(title=f"{title} · {html.escape(app.name)}", body=body, **colors)


def run_chromium(app, url):
    data_dir = DATA_HOME / "lighthouse" / "chromium" / app.id
    os.execvp("chromium-browser", [
        "chromium-browser", "--no-first-run", f"--user-data-dir={data_dir}", f"--app={url}",
    ])


def load_theme():
    try:
        with open(THEME) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


TOOLBAR_QSS = """
QToolBar {{ background: {surface_variant}; border: none; padding: 6px 10px; spacing: 8px; }}
QToolBar QLabel {{ color: {on_surface_variant}; font-weight: bold; font-size: 15px; }}
QToolButton {{ background: {primary}; color: {on_primary}; border: none; border-radius: 18px;
              min-width: 44px; min-height: 36px; }}
QToolButton:hover {{ background: {secondary}; color: {on_secondary}; }}
QToolButton:disabled {{ background: {surface}; color: {outline}; }}
"""


def run_blink(app, url):
    # QtWebEngine reads these at startup: no remote DevTools, ever.
    os.environ.pop("QTWEBENGINE_REMOTE_DEBUGGING", None)

    from PySide6.QtCore import QBuffer, QByteArray, QIODevice, QSize, Qt, QTimer, QUrl
    from PySide6.QtGui import QIcon, QKeySequence, QPixmap, QShortcut
    from PySide6.QtWebEngineCore import (QWebEnginePage, QWebEngineProfile, QWebEngineSettings,
                                         QWebEngineUrlRequestInterceptor, QWebEngineUrlRequestInfo,
                                         QWebEngineUrlRequestJob, QWebEngineUrlScheme,
                                         QWebEngineUrlSchemeHandler)
    from PySide6.QtWebEngineWidgets import QWebEngineView
    from PySide6.QtWidgets import QApplication, QLabel, QMainWindow, QSizePolicy, QToolBar, QWidget

    # lighthouse:// holds the kid's "ask a grown-up" pages. It's a local scheme,
    # so web pages can't link to it; only the app and its own pages can.
    scheme = QWebEngineUrlScheme(b"lighthouse")
    scheme.setSyntax(QWebEngineUrlScheme.Syntax.Host)
    scheme.setFlags(QWebEngineUrlScheme.Flag.SecureScheme | QWebEngineUrlScheme.Flag.LocalScheme
                    | QWebEngineUrlScheme.Flag.LocalAccessAllowed)
    QWebEngineUrlScheme.registerScheme(scheme)

    qt_app = QApplication([sys.argv[0]])
    qt_app.setApplicationName(app.name)
    qt_app.setDesktopFileName(f"org.lighthouse.webapp.{app.id.replace('-', '_')}")  # Wayland app id

    theme = load_theme()
    if theme and hasattr(qt_app.styleHints(), "setColorScheme"):
        qt_app.styleHints().setColorScheme(
            Qt.ColorScheme.Dark if theme.get("mode") == "dark" else Qt.ColorScheme.Light)

    # What the kid is waiting on: {"url": ..., "request": id or None}
    waiting = {}

    def show(kind, target):
        waiting.update(url=target)
        view.load(QUrl(f"lighthouse://{kind}?url={quote(target, safe='')}"))

    class KidPages(QWebEngineUrlSchemeHandler):
        def requestStarted(self, job):
            target = parse_qs(job.requestUrl().query()).get("url", [""])[0]
            kind = job.requestUrl().host()
            if not target.startswith(("http://", "https://")) or kind not in ("blocked", "ask"):
                return job.fail(QWebEngineUrlRequestJob.Error.UrlInvalid)
            if kind == "ask":
                # Only our own "blocked" page may ask.
                if job.initiator().scheme() != "lighthouse":
                    return job.fail(QWebEngineUrlRequestJob.Error.RequestDenied)
                waiting["request"] = ask_parent(app, target)
                kind = "asked" if waiting["request"] else "offline"
            else:
                waiting["request"] = None
            waiting["url"] = target
            buf = QBuffer(parent=job)
            buf.setData(QByteArray(kid_page(app, kind, target, theme).encode()))
            buf.open(QIODevice.OpenModeFlag.ReadOnly)
            job.reply(QByteArray(b"text/html"), buf)

    def check_waiting():
        """While a kid page is showing, open the page as soon as a grown-up allows it."""
        if page.url().scheme() != "lighthouse" or not waiting.get("url"):
            return
        if app.allows(waiting["url"]):
            view.load(QUrl(waiting.pop("url")))
        elif waiting.get("request") and request_status(waiting["request"]) == "denied":
            waiting["request"] = None
            page.setHtml(kid_page(app, "denied", waiting["url"], theme), QUrl("lighthouse://denied"))

    class FrameGuard(QWebEngineUrlRequestInterceptor):
        """Second line of defence: block page and frame loads the allowlist doesn't cover."""
        FRAMES = (QWebEngineUrlRequestInfo.ResourceType.ResourceTypeMainFrame,
                  QWebEngineUrlRequestInfo.ResourceType.ResourceTypeSubFrame)

        def interceptRequest(self, info):
            uri = info.requestUrl().toString()
            if (info.resourceType() in self.FRAMES and info.requestUrl().scheme() != "lighthouse"
                    and not app.allows(uri)):
                blocked(app, uri)
                info.block(True)

    class Page(QWebEnginePage):
        def acceptNavigationRequest(self, qurl, nav_type, is_main_frame):
            if qurl.scheme() == "lighthouse":
                return True
            uri = qurl.toString()
            if app.allows(uri):
                return True
            blocked(app, uri)
            if is_main_frame and qurl.scheme() in ("http", "https"):
                QTimer.singleShot(0, lambda: show("blocked", uri))
            return False

        def createWindow(self, _type):
            # One window per app: pop-ups and target=_blank links open in place
            # (acceptNavigationRequest still applies to them).
            return self

        def javaScriptConsoleMessage(self, *args):
            pass

    storage = f"lighthouse/blink/{app.id}"
    profile = QWebEngineProfile(app.id)
    profile.setPersistentStoragePath(str(DATA_HOME / storage))
    profile.setCachePath(str(CACHE_HOME / storage))
    if app.user_agent:
        profile.setHttpUserAgent(app.user_agent)
    guard = FrameGuard()
    profile.setUrlRequestInterceptor(guard)
    kid_pages = KidPages()
    profile.installUrlSchemeHandler(b"lighthouse", kid_pages)
    profile.downloadRequested.connect(
        lambda d: (blocked(app, f"download {d.url().toString()}"), d.cancel()))

    page = Page(profile)
    settings = page.settings()
    settings.setAttribute(QWebEngineSettings.WebAttribute.JavascriptCanOpenWindows, False)
    settings.setAttribute(QWebEngineSettings.WebAttribute.LocalContentCanAccessRemoteUrls, False)
    if hasattr(page, "permissionRequested"):  # Qt >= 6.8
        page.permissionRequested.connect(lambda permission: permission.deny())

    view = QWebEngineView()
    view.setPage(page)
    view.setContextMenuPolicy(Qt.ContextMenuPolicy.NoContextMenu)

    window = QMainWindow()
    window.setWindowTitle(app.name)
    window.resize(1280, 800)
    window.setCentralWidget(view)
    view.titleChanged.connect(lambda title: window.setWindowTitle(title or app.name))

    def icon(name):
        """An Adwaita symbolic icon, recoloured to the theme's on-primary colour."""
        try:
            svg = (ICONS / f"{name}-symbolic.svg").read_text()
        except OSError:
            return QIcon()
        colour = theme["colors"]["on_primary"] if theme else "#FFFFFF"
        svg = re.sub(r'fill="#[0-9a-fA-F]{3,8}"', f'fill="{colour}"', svg)
        svg = re.sub(r"fill:#[0-9a-fA-F]{3,8}", f"fill:{colour}", svg)
        pixmap = QPixmap()
        pixmap.loadFromData(svg.encode(), "SVG")
        return QIcon(pixmap)

    # Back, forward and home, sized for small hands.
    toolbar = QToolBar(movable=False, floatable=False)
    toolbar.setContextMenuPolicy(Qt.ContextMenuPolicy.PreventContextMenu)
    toolbar.setIconSize(QSize(22, 22))
    back = toolbar.addAction(icon("go-previous"), "Back", view.back)
    forward = toolbar.addAction(icon("go-next"), "Forward", view.forward)
    toolbar.addAction(icon("go-home"), "Home", lambda: view.load(QUrl(app.url)))
    left, right = QWidget(), QWidget()
    for spacer in (left, right):
        spacer.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
    toolbar.addWidget(left)
    toolbar.addWidget(QLabel(app.name))
    toolbar.addWidget(right)
    window.addToolBar(toolbar)
    if theme:
        toolbar.setStyleSheet(TOOLBAR_QSS.format(**theme["colors"]))

    def update_buttons(*_):
        history = view.history()
        back.setEnabled(history.canGoBack())
        forward.setEnabled(history.canGoForward())
    view.urlChanged.connect(update_buttons)
    view.loadFinished.connect(update_buttons)
    update_buttons()

    for keys, action in (("Alt+Left", view.back), ("Alt+Right", view.forward),
                         ("Alt+Home", lambda: view.load(QUrl(app.url)))):
        QShortcut(QKeySequence(keys), window, activated=action)

    timer = QTimer(interval=3000)
    timer.timeout.connect(check_waiting)
    timer.start()

    view.load(QUrl(url))
    window.show()
    return qt_app.exec()


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("app_id", help="desktop entry id, e.g. pbskids")
    parser.add_argument("--url", help="start at this URL instead (must be allowed)")
    args = parser.parse_args()

    app = App(args.app_id)
    url = args.url or app.url
    if not app.allows(url):
        sys.exit(f"lighthouse-webapp: {url} is not allowed for '{app.id}'")

    if app.engine == "chromium":
        run_chromium(app, url)
    return run_blink(app, url)


if __name__ == "__main__":
    sys.exit(main())
