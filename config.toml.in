# Room for two bootc deployments, so mise run vm-update can stage upgrades.
# (The filesystem type comes from --rootfs btrfs.)
[[customizations.filesystem]]
mountpoint = "/"
minsize = "24 GiB"

# The child's account: autologin only, no password, no admin rights.
[[customizations.user]]
name = "kid"
description = "Kid Explorer"
home = "/var/home/kid"

# The parent/maintainer account: SSH key only. The key is filled in by `mise run disk`.
[[customizations.user]]
name = "admin"
description = "Lighthouse Admin"
key = "@ADMIN_SSH_KEY@"
groups = ["wheel"]
